project_id          = "dayservice-prod-123456"   # 自分のプロジェクト ID に置き換える
region              = "asia-northeast1"
zone                = "asia-northeast1-a"
name                = "dayservice"
machine_type        = "e2-small"                 # 安く: "e2-micro"（1GB・スワップあり）
disk_size_gb        = 30
ssh_user            = "deploy"
ssh_public_key_path = "~/.ssh/id_ed25519.pub"

# Always Free 枠（VM 代 $0）を使う場合はこの3行に置き換える。日本からは遅延が 100ms ほど増える
# region       = "us-central1"
# zone         = "us-central1-a"
# machine_type = "e2-micro"

# 事務所の固定IPがあれば SSH を絞る（GitHub Actions からのデプロイには 0.0.0.0/0 が必要）
# ssh_allowed_cidrs = ["203.0.113.10/32"]

enable_backup_bucket = true
# backup_bucket_name = "dayservice-backups-xxxx"   # 空なら name-backups-project_id で自動生成
