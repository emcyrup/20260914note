# Django設定
SECRET_KEY=your-secret-key-here
DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# データベース（ローカル開発はSQLiteを使用するため空欄でOK）
# DB_NAME を設定すると PostgreSQL を使う
# DB_NAME=dayservice
# DB_USER=dayservice
# DB_PASSWORD=
# DB_HOST=localhost
# DB_PORT=5432

# リバースプロキシ越しのHTTPSで使う（本番のみ。例: https://app.example.com）
# CSRF_TRUSTED_ORIGINS=

# Anthropic Claude API
ANTHROPIC_API_KEY=

# LINE Messaging API
LINE_CHANNEL_ACCESS_TOKEN=
LINE_CHANNEL_SECRET=

# アプリ設定
APP_PORT=8000

# 静的ファイル・アップロード先（本番環境のみ）
# STATIC_ROOT=/path/to/staticfiles
# MEDIA_ROOT=/path/to/media
