# =============================================
# 「りょういく」用の別サーバー（GCP・Docker Compose）の .env
#   サーバーの /opt/ryoiku/.env に置く。Git には入れない。chmod 600
#   手順は docs/RYOIKU_SERVER.md
# =============================================

# Django
SECRET_KEY=ここに50文字以上のランダム文字列（python3 -c "import secrets; print(secrets.token_urlsafe(64))"）
DEBUG=False
# まず IP で動かすときは固定IP。ドメインを付けたらドメインに変える（カンマ区切りで複数可）
DJANGO_ALLOWED_HOSTS=<固定IP>
CSRF_TRUSTED_ORIGINS=http://<固定IP>
# IP で動かす間は False。ドメインを付けて HTTPS にしたら True
SECURE_SSL_REDIRECT=False
# Caddy の自動 HTTPS 用のドメイン。IP で動かす間は空
DOMAIN=

# アプリのワーカー数（VM のメモリが 1GB なら 1、2GB 以上なら 2）
# シンプルのサーバーは e2-micro（1GB）でページ遷移が数秒かかったため、e2-small（2GB）＋ワーカー2 を勧める
GUNICORN_WORKERS=2
GUNICORN_THREADS=2

# PostgreSQL（compose 内の db コンテナ）
DB_NAME=ryoiku
DB_USER=ryoiku
DB_PASSWORD=ここに強いパスワード（openssl rand -base64 24）

# 自己登録は使わない（事業所は create_facility で作る）
ALLOW_FACILITY_SIGNUP=False
SIGNUP_CODE=

# Anthropic Claude API（AI を使うなら）
ANTHROPIC_API_KEY=

# LINE は施設設定の画面で事業所ごとに入れる（ここは空でよい）
LINE_CHANNEL_ACCESS_TOKEN=
LINE_CHANNEL_SECRET=

# バックアップ先のバケット（任意。作ったら名前を入れる。認証は VM のサービスアカウント）
# BACKUP_GCS_BUCKET=ryoiku-backups-<プロジェクトID>

# 配備したイメージ（GitHub Actions が書き換える。手で触らない）
# APP_IMAGE=ghcr.io/emcyrup/20260914note:ryoiku
