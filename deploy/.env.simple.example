# =============================================
# 「シンプル」用の別サーバーの .env（サーバーの ~/simple/.env に置く。Git には入れない。chmod 600）
#   開発環境と同じ構成（プロバイダの nginx が HTTPS を終端し、割り当てポートの Gunicorn に中継。venv は ~/env）
#   手順は docs/SIMPLE_SERVER.md
# =============================================

# Django
SECRET_KEY=ここに50文字以上のランダム文字列（python -c "import secrets; print(secrets.token_urlsafe(50))"）
DEBUG=False
DJANGO_ALLOWED_HOSTS=simple.example.jp,サーバーのIP
CSRF_TRUSTED_ORIGINS=https://simple.example.jp
SECURE_SSL_REDIRECT=True

# Gunicorn（deploy/venv-deploy.sh が読む）。ポートはプロバイダから割り当てられた番号
PORT=8030
GUNICORN_WORKERS=2

# PostgreSQL（プロバイダ管理の DB。開発環境とは別の DB にする）
DB_NAME=simple
DB_USER=ここに DB ユーザー
DB_PASSWORD=ここに DB ユーザーのパスワード
DB_HOST=localhost
DB_PORT=5432

# 写真・ロゴなどの保存先（ホームディレクトリ内の絶対パス）
MEDIA_ROOT=/home/ユーザー/simple/media

# 自己登録は使わない（事業所は create_facility で作る）
ALLOW_FACILITY_SIGNUP=False
SIGNUP_CODE=

# Anthropic Claude API（AI を使うなら）
ANTHROPIC_API_KEY=

# LINE は施設設定の画面で事業所ごとに入れる（ここは空でよい）
LINE_CHANNEL_ACCESS_TOKEN=
LINE_CHANNEL_SECRET=
