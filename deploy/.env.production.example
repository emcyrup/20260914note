# =============================================
# 本番用 .env（サーバーの /opt/dayservice/.env に置く。Gitには入れない）
# =============================================

# Django
SECRET_KEY=ここに50文字以上のランダム文字列
DEBUG=False
# Caddy で使うドメイン。カンマ区切りで複数可。IP直アクセスで試す場合は IP を書く
DJANGO_ALLOWED_HOSTS=app.example.com
# https://ドメイン の形式（CSRF対策。ドメインを設定したら必ず入れる）
CSRF_TRUSTED_ORIGINS=https://app.example.com
# ドメインなし（http://IP）で検証する間だけ False にする。本番は True
SECURE_SSL_REDIRECT=True

# Caddy（自動HTTPS）。IP直アクセスで検証する間は空にしておく
DOMAIN=app.example.com

# PostgreSQL（compose 内の db コンテナ）
DB_NAME=dayservice
DB_USER=dayservice
DB_PASSWORD=ここに強いパスワード

# Anthropic Claude API（日誌のAI生成）
ANTHROPIC_API_KEY=

# LINE Messaging API
LINE_CHANNEL_ACCESS_TOKEN=
LINE_CHANNEL_SECRET=

# バックアップ（任意）。S3 に送る場合は Terraform が作った IAM ユーザーのキーとバケット名
# BACKUP_S3_BUCKET=
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# AWS_DEFAULT_REGION=ap-northeast-1
