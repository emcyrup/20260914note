# =============================================
# AWS 開発環境用 .env（サーバーの /opt/michinotedemo/.env に置く。Git には入れない）
#   nginx が https://st-michinotedemo.ai-labo.cloud/ を 127.0.0.1:8029 に中継する構成
# =============================================

# Django
SECRET_KEY=ここに50文字以上のランダム文字列（python -c "import secrets; print(secrets.token_urlsafe(50))"）
DEBUG=False
DJANGO_ALLOWED_HOSTS=st-michinotedemo.ai-labo.cloud
CSRF_TRUSTED_ORIGINS=https://st-michinotedemo.ai-labo.cloud
# nginx が HTTPS を終端し X-Forwarded-Proto: https を付けるので True のまま
SECURE_SSL_REDIRECT=True

# app コンテナを公開するポート（nginx の proxy_pass 先）。loopback のみ
APP_PORT=8029
COMPOSE_PROJECT_NAME=michinotedemo

# PostgreSQL（サーバー上の既存 PostgreSQL を使う）
DB_NAME=michinotedemo
DB_USER=st_ai_labo_dbuser
DB_PASSWORD=ここに DB ユーザーのパスワード
# ホストの PostgreSQL なら host.docker.internal（既定）。RDS などなら そのホスト名
DB_HOST=host.docker.internal
DB_PORT=5432

# /media/ を nginx の alias で配信する場合は False（deploy/nginx.example.conf 参照）
SERVE_MEDIA=True

# Anthropic Claude API
ANTHROPIC_API_KEY=
# 省略時: AI_PLAN_MODEL=claude-opus-5 / AI_TEXT_MODEL=claude-opus-5
#AI_TEXT_MODEL=claude-sonnet-5

# LINE（この事業所では未使用）
LINE_CHANNEL_ACCESS_TOKEN=
LINE_CHANNEL_SECRET=
