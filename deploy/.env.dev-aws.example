# =============================================
# AWS 開発環境用 .env（サーバーの ~/michinotedemo/.env に置く。Git には入れない。chmod 600）
#   プロバイダの nginx が https://st-michinotedemo.ai-labo.cloud/ を 0.0.0.0:8029 の Gunicorn に中継する構成
#   （sudo なし・Docker なし・venv は ~/env）
# =============================================

# Django
SECRET_KEY=ここに50文字以上のランダム文字列（python -c "import secrets; print(secrets.token_urlsafe(50))"）
DEBUG=False
DJANGO_ALLOWED_HOSTS=st-michinotedemo.ai-labo.cloud,15.168.83.1
CSRF_TRUSTED_ORIGINS=https://st-michinotedemo.ai-labo.cloud
# nginx が X-Forwarded-Proto: https を付けていれば True。ログイン後に無限リダイレクトする場合は False にする
SECURE_SSL_REDIRECT=True

# Gunicorn（deploy/venv-deploy.sh が読む）。ポートはプロバイダから割り当てられた番号
PORT=8029
GUNICORN_WORKERS=2

# PostgreSQL（サーバー上のプロバイダ管理 DB）
DB_NAME=michinotedemo
DB_USER=st_ai_labo_dbuser
DB_PASSWORD=ここに DB ユーザーのパスワード
DB_HOST=localhost
DB_PORT=5432

# nginx を触れない環境なので写真は Django が配信する
# 写真・紙の日誌・ロゴの保存先（ホームディレクトリ内の絶対パスにする）
MEDIA_ROOT=/home/dev4/michinotedemo/media

# Anthropic Claude API
# 自己登録：新しい事業所をログイン画面から登録できるようにする（True/False）。SIGNUP_CODE を設定すると、そのコードが必要
ALLOW_FACILITY_SIGNUP=False
SIGNUP_CODE=

ANTHROPIC_API_KEY=
# 省略時: AI_PLAN_MODEL=claude-opus-5 / AI_TEXT_MODEL=claude-opus-5
#AI_TEXT_MODEL=claude-sonnet-5

# LINE（この事業所では未使用）
LINE_CHANNEL_ACCESS_TOKEN=
LINE_CHANNEL_SECRET=
