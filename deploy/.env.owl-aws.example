# =============================================
# 「児童発達支援センター　オウル」AWS 共用サーバー用 .env（サーバーの ~/michinoteowl/.env に置く。Git には入れない。chmod 600）
#   プロバイダの nginx が https://michinote.owl.ai-labo.cloud/ を 0.0.0.0:8034 の Gunicorn に中継する構成
#   （sudo なし・Docker なし・venv は ~/env。ゆあーず（~/michinoteyours・8030）と同じサーバー・同じ仕組みで、置き場所・ポート・DB が違う）
#   Deploy (owl) の初回実行で、この雛形から自動で作られる（SECRET_KEY は生成、DB パスワードなどはゆあーずの .env から写す）
#   手順は docs/DEPLOY_AWS_OWL.md
# =============================================

# Django
SECRET_KEY=ここに50文字以上のランダム文字列（python -c "import secrets; print(secrets.token_urlsafe(50))"）
DEBUG=False
DJANGO_ALLOWED_HOSTS=michinote.owl.ai-labo.cloud
CSRF_TRUSTED_ORIGINS=https://michinote.owl.ai-labo.cloud
# nginx が X-Forwarded-Proto: https を付けていれば True。ログイン後に無限リダイレクトする場合は False にする
SECURE_SSL_REDIRECT=True

# Gunicorn（deploy/venv-deploy.sh が読む）。ポートはプロバイダから割り当てられた番号
PORT=8034
GUNICORN_WORKERS=2

# PostgreSQL（サーバー上のプロバイダ管理 DB）
DB_NAME=michinoteowl
DB_USER=ai_labo_dbuser
DB_PASSWORD=ここに DB ユーザーのパスワード（プロバイダ発行）
DB_HOST=localhost
DB_PORT=5432

# nginx を触れない環境なので写真は Django が配信する
# 写真・紙の利用希望・ロゴの保存先（ホームディレクトリ内の絶対パスにする。開発環境の media とは別の場所）
# ~ は自分のホームに展開される。別ユーザーのホームなど作れないパスを書くと、~/michinoteowl/media に切り替えて警告が出る
MEDIA_ROOT=~/michinoteowl/media

# 自己登録は使わない（事業所は Manage (owl) の create_facility で作る。職員の登録はログイン画面の「職員の新規登録」）
ALLOW_FACILITY_SIGNUP=False
SIGNUP_CODE=

# Anthropic Claude API（お試しの AI・療育記録の AI・議事録の AI）
ANTHROPIC_API_KEY=
# 省略時: AI_PLAN_MODEL=claude-opus-5 / AI_TEXT_MODEL=claude-opus-5
#AI_TEXT_MODEL=claude-sonnet-5

# iPhone の音声入力（議事録・留意点など）で、音声を Google Cloud Speech-to-Text で文字にする
# Cloud Speech-to-Text API だけに制限した API キー。IP で制限するなら、このサーバーの IP を許可する（docs/RYOIKU_SERVER.md 3-7c）
GOOGLE_SPEECH_API_KEY=
# Google を使わず、サーバーの中で文字にする（faster-whisper）。モデル名を入れると配備時に部品が入り、最初の利用でモデルを取得する
# 速さは Actions の「Speech check (yours)（同じサーバーなので結果は同じ）」で測る。small=速い・medium=精度は上がるが遅い・kotoba-tech/kotoba-whisper-v2.0-faster=日本語向け
#WHISPER_MODEL=small
#WHISPER_THREADS=2

# LINE は施設設定の画面で事業所ごとに入れる（ここは空でよい）
LINE_CHANNEL_ACCESS_TOKEN=
LINE_CHANNEL_SECRET=

# 期限のお知らせのメール（python manage.py send_reminders を cron で毎朝実行。docs/DEPLOY_AWS_OWL.md 4）
# 空のままなら送れない（ホームの「お知らせ・アラート」だけ使う）。Gmail なら EMAIL_HOST=smtp.gmail.com、アプリ パスワードを EMAIL_HOST_PASSWORD に
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=True
DEFAULT_FROM_EMAIL=
# メールに載せるリンクの先頭（send_reminders --base-url でも指定できる）
RESERVATION_SITE_URL=https://michinote.owl.ai-labo.cloud
