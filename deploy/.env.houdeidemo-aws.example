# =============================================
# 放課後等デイサービスのデモ事業所「放デイ　デモ」（2026-11-06）用 .env（開発環境のサーバー。~/michinotehoudei/.env に置く。Git には入れない。chmod 600）
#   プロバイダの nginx が https://<HOUDEIDEMO_DOMAIN>/ を 127.0.0.1:<HOUDEIDEMO_PORT> の Gunicorn に中継する構成（プロバイダに用意してもらう）
#   （sudo なし・Docker なし・venv は ~/env。開発環境（~/michinotedemo・8029）・コト（~/kaigonotekyotaku・8039）・やすらぎの森（~/kaigonotemidorikai・8045）・老健デモ（~/kaigonotedemo・8046）と同じサーバー・同じ仕組み）
#   Deploy (houdeidemo) の初回実行で、この雛形から自動で作られる（SECRET_KEY は生成、DB パスワードなどは開発環境の .env から写す。
#   アドレス・ポート・DB_NAME は Secrets の HOUDEIDEMO_DOMAIN・HOUDEIDEMO_PORT・HOUDEIDEMO_DB_NAME、必須）
#   手順は docs/DEPLOY_AWS_HOUDEIDEMO.md
# =============================================

# Django
SECRET_KEY=ここに50文字以上のランダム文字列（python -c "import secrets; print(secrets.token_urlsafe(50))"）
DEBUG=False
DJANGO_ALLOWED_HOSTS=HOUDEIDEMO_DOMAIN_PLACEHOLDER
CSRF_TRUSTED_ORIGINS=https://HOUDEIDEMO_DOMAIN_PLACEHOLDER
# nginx が X-Forwarded-Proto: https を付けていれば True。ログイン後に無限リダイレクトする場合は False にする
SECURE_SSL_REDIRECT=True

# Gunicorn（deploy/venv-deploy.sh が読む）。ポートはプロバイダから割り当てられた番号
PORT=0
GUNICORN_WORKERS=2

# PostgreSQL（サーバー上のプロバイダ管理 DB）
DB_NAME=michinotesample
DB_USER=st_ai_labo_dbuser
DB_PASSWORD=ここに DB ユーザーのパスワード（プロバイダ発行）
DB_HOST=localhost
DB_PORT=5432

# nginx を触れない環境なので写真は Django が配信する
# 写真・書類・ロゴの保存先（ホームディレクトリ内の絶対パスにする。ほかの環境の media とは別の場所）
# ~ は自分のホームに展開される。別ユーザーのホームなど作れないパスを書くと、~/michinotehoudei/media に切り替えて警告が出る
MEDIA_ROOT=~/michinotehoudei/media

# 自己登録は使わない（事業所は Manage (houdeidemo) の create_facility で作る。職員の登録はログイン画面の「職員の新規登録」）
ALLOW_FACILITY_SIGNUP=False
SIGNUP_CODE=

# Anthropic Claude API（日誌の AI・個別支援計画の下書き・加算提案・書類の読み取り）
ANTHROPIC_API_KEY=
# 省略時: AI_PLAN_MODEL=claude-opus-5 / AI_TEXT_MODEL=claude-opus-5
#AI_TEXT_MODEL=claude-sonnet-5

# iPhone の音声入力（議事録・留意点など）で、音声を Google Cloud Speech-to-Text で文字にする
# Cloud Speech-to-Text API だけに制限した API キー。IP で制限するなら、このサーバーの IP を許可する（docs/RYOIKU_SERVER.md 3-7c）
GOOGLE_SPEECH_API_KEY=
# 配車表の所要時間に Google マップを使うとき（空なら国土地理院＋OSRM の無料の経路）
GOOGLE_MAPS_API_KEY=
# Google を使わず、サーバーの中で文字にする（faster-whisper）。モデル名を入れると配備時に部品が入り、最初の利用でモデルを取得する
# small=速い・medium=精度は上がるが遅い・kotoba-tech/kotoba-whisper-v2.0-faster=日本語向け
#WHISPER_MODEL=small
#WHISPER_THREADS=2

# LINE は施設設定の画面で事業所ごとに入れる（ここは空でよい。デモでは未設定）
LINE_CHANNEL_ACCESS_TOKEN=
LINE_CHANNEL_SECRET=

# 期限のお知らせのメール（python manage.py send_reminders を cron で毎朝実行）
# 空のままなら送れない（ホームの「お知らせ・アラート」だけ使う）。Gmail なら EMAIL_HOST=smtp.gmail.com、アプリ パスワードを EMAIL_HOST_PASSWORD に
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=True
DEFAULT_FROM_EMAIL=
# メールに載せるリンクの先頭（send_reminders --base-url でも指定できる）
RESERVATION_SITE_URL=https://HOUDEIDEMO_DOMAIN_PLACEHOLDER
